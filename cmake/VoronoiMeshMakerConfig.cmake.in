@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Policy handling for modern FindPython behaviour
if(POLICY CMP0167)
    cmake_policy(PUSH)
    cmake_policy(SET CMP0167 NEW)
    set(_vmm_policy_cmp0167 "${CMAKE_POLICY_DEFAULT_CMP0167}")
    set(CMAKE_POLICY_DEFAULT_CMP0167 NEW)
endif()

# ⚠️ NOTE: CGAL and TBB are linked PRIVATE in the library target.
# They are only required if consumers explicitly use internal backend headers.
# For standard public API usage, these dependencies are optional.
find_dependency(CGAL OPTIONAL COMPONENTS Core)
find_dependency(TBB  OPTIONAL)

if(POLICY CMP0167)
    set(CMAKE_POLICY_DEFAULT_CMP0167 "${_vmm_policy_cmp0167}")
    unset(_vmm_policy_cmp0167)
    cmake_policy(POP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VoronoiMeshMakerTargets.cmake")
check_required_components(VoronoiMeshMaker)